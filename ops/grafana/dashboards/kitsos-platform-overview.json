{
  "id": null,
  "uid": "kitsos-platform-overview",
  "title": "Kitsos Platform Analytics",
  "description": "Admin dashboard: durable product inventory from the Kitsos Analytics API and time-scoped API usage from Axiom.",
  "tags": [
    "kitsos",
    "analytics",
    "admin"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Current product inventory",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "kitsos-analytics-api"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "kitsos-analytics-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://keys.api.kitsos.net/v1/analytics/overview",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "usersActive",
              "text": "Active users",
              "type": "number"
            },
            {
              "selector": "usersTotal",
              "text": "Users total",
              "type": "number"
            },
            {
              "selector": "appsTotal",
              "text": "Apps",
              "type": "number"
            },
            {
              "selector": "hmeAliasesActive",
              "text": "Active HME aliases",
              "type": "number"
            },
            {
              "selector": "hmeAliasesTotal",
              "text": "HME aliases total",
              "type": "number"
            },
            {
              "selector": "hmeEmailsForwardedTotal",
              "text": "HME forwarded total",
              "type": "number"
            },
            {
              "selector": "verifiedResourcesTotal",
              "text": "Verified resources",
              "type": "number"
            },
            {
              "selector": "mailTemplatesTotal",
              "text": "Mail templates",
              "type": "number"
            },
            {
              "selector": "mailWebhooksTotal",
              "text": "Mail webhooks",
              "type": "number"
            }
          ],
          "json_options": {
            "columnar": false,
            "root_is_not_array": true
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "description": "Current D1-backed state. These values are not affected by the dashboard time range."
    },
    {
      "id": 2,
      "title": "Authenticated API usage",
      "type": "stat",
      "datasource": {
        "type": "axiomhq-axiom-datasource",
        "uid": "kitsos-axiom"
      },
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "axiomhq-axiom-datasource",
            "uid": "kitsos-axiom"
          },
          "apl": "['api-logs']\n| where ['kind'] == \"server\"\n| extend user_id=tostring(['attributes.custom']['kitsos.user.id']), status=toint(['attributes.http.response.status_code'])\n| where isnotempty(user_id) and isnotnull(status)\n| summarize requests=count(), successful=countif(status < 400), errors=countif(status >= 400), active_users=dcount(user_id)\n| extend success_rate=round(100.0 * todouble(successful) / requests, 2)",
          "totals": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "description": "Authenticated server requests in the selected time range. Anonymous requests and health checks are excluded."
    },
    {
      "id": 3,
      "title": "Product events in selected range",
      "type": "stat",
      "datasource": {
        "type": "axiomhq-axiom-datasource",
        "uid": "kitsos-axiom"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "axiomhq-axiom-datasource",
            "uid": "kitsos-axiom"
          },
          "apl": "['api-logs']\n| where ['kind'] == \"server\"\n| extend event_name=tostring(['attributes.custom']['kitsos.event.name']), outcome=tostring(['attributes.custom']['kitsos.event.outcome'])\n| where event_name == \"mail.message.send\" and outcome == \"success\"\n| summarize brevo_emails_sent=count()",
          "totals": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "axiomhq-axiom-datasource",
            "uid": "kitsos-axiom"
          },
          "apl": "['api-logs']\n| where ['kind'] == \"server\"\n| extend event_name=tostring(['attributes.custom']['kitsos.event.name']), outcome=tostring(['attributes.custom']['kitsos.event.outcome'])\n| where event_name == \"hme.email.forward\" and outcome == \"success\"\n| summarize hme_emails_forwarded=count()",
          "totals": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "brevo_emails_sent"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Brevo emails sent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hme_emails_forwarded"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "HME emails forwarded"
              }
            ]
          }
        ]
      },
      "description": "Successful semantic product events captured in Axiom during the selected time range."
    },
    {
      "id": 4,
      "title": "Authenticated requests by API",
      "type": "timeseries",
      "datasource": {
        "type": "axiomhq-axiom-datasource",
        "uid": "kitsos-axiom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "axiomhq-axiom-datasource",
            "uid": "kitsos-axiom"
          },
          "apl": "['api-logs']\n| where ['kind'] == \"server\"\n| extend user_id=tostring(['attributes.custom']['kitsos.user.id']), api=tostring(['service.name']), status=toint(['attributes.http.response.status_code'])\n| where isnotempty(user_id) and isnotnull(status)\n| summarize requests=count() by bin_auto(['_time']), api\n| sort by ['_time'] asc",
          "totals": false
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
